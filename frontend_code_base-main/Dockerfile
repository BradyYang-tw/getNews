FROM node:alpine
WORKDIR /usr/src/app

ARG VITE_API_BASE_URL
ARG VITE_OV_VIEWER_URL
ARG VITE_AZURE_TENANT_ID
ARG VITE_AZURE_APPLICATION_ID

COPY . /usr/src/app/
RUN npm install

RUN printf "VITE_API_BASE_URL=%s\nVITE_OV_VIEWER_URL=%s\nVITE_AZURE_TENANT_ID=%s\nVITE_AZURE_APPLICATION_ID=%s\n" \
  "$VITE_API_BASE_URL" \
  "$VITE_OV_VIEWER_URL" \
  "$VITE_AZURE_TENANT_ID" \
  "$VITE_AZURE_APPLICATION_ID" > .env.dev

EXPOSE 3000
CMD ["yarn", "dev"]